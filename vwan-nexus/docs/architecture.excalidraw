   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Pods that call Nexus themselves must mount the CA (node trust is not injected into containers). Outbound only: on-prem-initiated flows into AKS need a separate design.",
   "originalText": "Pods that call Nexus themselves must mount the CA (node trust is not injected into containers). Outbound only: on-prem-initiated flows into AKS need a separate design.",
