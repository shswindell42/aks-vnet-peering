  {
   "id": "te83",
   "type": "text",
   "x": 52,
   "y": 690,
   "width": 996,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#000000",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 83,
   "version": 1,
   "versionNonce": 83,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Learns ONLY:  172.19.0.0/28 \u00b7 172.20.0.0/28 \u00b7 172.21.0.0/28 \u00b7 10.30.0.0/24 \u00b7 on-prem prefixes (ER / VPN)\n100.64.0.0/16 is never advertised, so the same range can be reused per environment (no overlap on the hub)\nRouting intent (Internet) \u2192 hub firewall: transit VNets learn 0.0.0.0/0; allow AKS required FQDNs from the transit /28s",
   "originalText": "Learns ONLY:  172.19.0.0/28 \u00b7 172.20.0.0/28 \u00b7 172.21.0.0/28 \u00b7 10.30.0.0/24 \u00b7 on-prem prefixes (ER / VPN)\n100.64.0.0/16 is never advertised, so the same range can be reused per environment (no overlap on the hub)\nRouting intent (Internet) \u2192 hub firewall: transit VNets learn 0.0.0.0/0; allow AKS required FQDNs from the transit /28s",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
