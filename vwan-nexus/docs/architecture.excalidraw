   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "On-prem (simulated with S2S VPN + BGP, 10.40.0.0/24): pod \u2192 on-prem server seen as client 172.19.0.6 (NVA) \u00b7 on-prem learned only 172.19.0.0/28, 10.30.0.0/24 and the hub prefix",
   "originalText": "On-prem (simulated with S2S VPN + BGP, 10.40.0.0/24): pod \u2192 on-prem server seen as client 172.19.0.6 (NVA) \u00b7 on-prem learned only 172.19.0.0/28, 10.30.0.0/24 and the hub prefix",
   "fontSize": 12,
   "fontFamily": 2,
